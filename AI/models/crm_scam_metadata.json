    "amount_if_transfer",
    "amount_if_cash_out",
    "amount_if_payment",
    "amount_if_cash_in",
    "amount_if_debit",
    "destination_prior_count",
    "destination_prior_count_log",
    "destination_age_steps",
    "destination_is_merchant"
  ],
  "categorical_features": [
    "transaction_type"
  ],
  "numeric_features": [
    "transaction_amount",
    "transaction_day_index",
    "transaction_hour_of_day",
    "transaction_log_amount",
    "transaction_week_index",
    "transaction_day_of_week",
    "hour_sin",
    "hour_cos",
    "amount_if_transfer",
    "amount_if_cash_out",
    "amount_if_payment",
