    "amount_if_debit",
    "destination_prior_count",
    "destination_prior_count_log",
    "destination_age_steps",
    "destination_is_merchant"
  ],
  "source_to_crm_mapping": {
    "type": "transaction_type",
    "amount": "transaction_amount",
    "step": "transaction date split into day index and hour of day",
    "nameOrig": "client or source account identifier excluded from prediction",
    "nameDest": "destination account identifier excluded from prediction"
  },
  "excluded_fields": [
    "isFlaggedFraud",
    "nameDest",
    "nameOrig",
    "newbalanceDest",
    "newbalanceOrig",
    "oldbalanceDest",
    "oldbalanceOrg",
    "transaction_status"
  ],
  "sampling": {
    "all_fraud_rows_retained": true,
    "legitimate_to_fraud_ratio": 20,
    "evaluation_prevalence_note": "Metrics are from the sampled cohort and do not represent production prevalence."
  },
  "metrics": {
    "precision": 0.4,
    "recall": 0.9421789409616556,
    "f1": 0.5615817159441321,
    "pr_auc": 0.9060024634571119,
    "roc_auc": 0.9858811357734227
  },
  "advisory_use_only": true,
  "training_improvements": {
    "amount_type_interactions": true,
    "cyclical_time_features": true,
    "prior_destination_history": true,
    "raw_account_ids_excluded": true,
    "validation_tuned_threshold": true,
    "selected_xgboost_config": {
      "scale_pos_weight": 12,
      "max_depth": 5,
      "min_child_weight": 5,
      "learning_rate": 0.035,
      "n_estimators": 750,
      "gamma": 0.05
    }
  }
